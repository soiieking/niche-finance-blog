{
  "build": {
    "env": {
      "HUGO_VERSION": "0.164.0"
    }
  },
  "buildCommand": "hugo --gc --minify",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.smart-stacking.com"
        }
      ],
      "destination": "https://smart-stacking.com/:path*",
      "permanent": true
    }
  ]
}
